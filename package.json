{
  "private": true,
  "workspaces": [
    "packages/@kdujs/*",
    "packages/test/*",
    "packages/kdu-cli-version-marker"
  ],
  "scripts": {
    "lint": "eslint --fix packages/**/*.js packages/**/bin/*",
    "check-links": "node scripts/checkLinks.js",
    "clean": "rimraf packages/test/* packages/**/temp/*",
    "sync": "node scripts/syncDeps.js",
    "boot": "node scripts/bootstrap.js",
    "release": "yarn --pure-lockfile && yarn clean && node scripts/release.js",
    "patch-chromedriver": "node scripts/patchChromedriver.js"
  },
  "gitHooks": {
    "pre-commit": "lint-staged",
    "commit-msg": "node scripts/verifyCommitMsg.js"
  },
  "lint-staged": {
    "*.{js,kdu}": [
      "eslint --fix",
      "git add"
    ],
    "packages/**/bin/*": [
      "eslint --fix",
      "git add"
    ]
  },
  "devDependencies": {
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "10.0.1",
    "debug": "4.1.0",
    "eslint": "5.14.1",
    "eslint-plugin-graphql": "3.0.3",
    "eslint-plugin-node": "8.0.0",
    "eslint-plugin-kdu": "5.1.0",
    "eslint-plugin-kdu-libs": "3.0.2",
    "execa": "1.0.0",
    "globby": "9.0.0",
    "graphql": "14.0.2",
    "http-server": "0.11.1",
    "inquirer": "6.0.0",
    "lerna": "3.13.0",
    "lint-staged": "8.1.4",
    "memfs": "2.15.2",
    "minimist": "1.2.0",
    "request": "2.83.0",
    "request-promise-native": "1.0.7",
    "rimraf": "2.6.2",
    "semver": "5.5.0",
    "typescript": "3.3.3333",
    "webpack": ">=4 < 4.29",
    "yorkie": "2.0.0"
  },
  "resolutions": {
    "@babel/core": "7.0.0",
    "@babel/preset-env": "7.0.0",
    "babel-core": "7.0.0-bridge.0",
    "ps-tree": "1.1.1",
    "puppeteer": "1.11.0",
    "kdu": "2.6.14",
    "kdu-template-compiler": "2.6.14",
    "kdu-server-renderer": "2.6.14"
  }
}
